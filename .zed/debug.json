// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Build & Debug native binary",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    // "program": "$ZED_WORKTREE_ROOT/target/debug/rts-core-engine.exe",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Debug rts-core-engine",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/rts-core-engine.exe",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [],
    "initCommands": [
      "settings set plugin.process.gdb-remote.packet-timeout 30",
      "settings set target.process.stop-on-exec false",
    ],
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "sourceLanguages": ["rust"],
    // "build_tasks": ["cargo build"]
  },
  {
    "label": "Debug rts-core-engine (cranelift)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/dev-cranelift/rts-core-engine.exe",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [],
    "initCommands": [
      "settings set plugin.process.gdb-remote.packet-timeout 30",
      "settings set target.process.stop-on-exec false",
    ],
    "sourceLanguages": ["rust"],
    "build_tasks": ["cargo build (cranelift)"],
  },
]
